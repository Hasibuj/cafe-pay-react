# Copy this file to `.env` in the project root (same folder as package.json).
# Restart `npm run dev` after any change — Vite only loads env at startup.
#
# Local: `npm run dev` serves /api/upload + /api/shop-meta via Vite middleware
# Production: set the same keys in Vercel → Settings → Environment Variables

# ─── Turso (libSQL) — off-chain shop/menu meta ───
# Create a DB at https://turso.tech → copy URL + create token
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# ─── Cloudflare R2 (server — do NOT use VITE_ on secrets) ───
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=your_r2_bucket

# Public base URL for objects (no trailing slash)
# e.g. https://pub-xxxxxxxxxxxxxxxx.r2.dev  or  https://images.yourdomain.com
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev

# ─── Client (safe — image URL construction in the browser) ───
# Must match R2_PUBLIC_BASE_URL
VITE_R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev
